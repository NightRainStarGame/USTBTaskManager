{
  "name": "task-manager",
  "version": "1.1.6",
  "description": "课程 / 项目 / 日历一体化可视化工作流（霓虹荧光科技风）",
  "main": "dist-electron/main.js",
  "author": "豆芽",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n VITE,ELEC -c green,cyan \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "tsc -p tsconfig.node.json && tsc -p tsconfig.json && node scripts/copy-static-assets.js && vite build",
    "build:mobile": "tsc -p tsconfig.json && vite build --config vite.mobile.config.ts && node -e \"require('fs').copyFileSync('dist-mobile/index-mobile.html','dist-mobile/index.html')\"",
    "cap:sync": "npm run build:mobile && npx cap sync android",
    "build:exe": "npm run build && electron-builder --win nsis --x64",
    "release:manifest": "node scripts/release.js",
    "release:one": "node scripts/release-one-click.js",
    "release:verify": "node scripts/release.js --verify",
    "publish:github": "node scripts/publish-github.js",
    "publish:vps": "node scripts/publish-vps.js",
    "publish:ustbcloud": "node scripts/upload-release-to-ustbcloud.js",
    "verify:vps": "node scripts/publish-vps.js --verify",
    "test:updater": "tsc -p tsconfig.node.json && node scripts/test-updater-sources.js",
    "verify:update": "node scripts/verify-live-update.js",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "better-sqlite3": "^11.5.0",
    "dayjs": "^1.11.13",
    "http-proxy-agent": "^7.0.2",
    "lucide-react": "^0.460.0",
    "lunar-javascript": "^1.6.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sql.js": "^1.14.2",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.douya.taskmanager",
    "productName": "TaskManager",
    "directories": {
      "output": "release-v${version}"
    },
    "files": [
      "dist/**",
      "!dist/assets/*-*.js",
      "!dist/assets/*-*.css",
      "dist-electron/**",
      "package.json",
      "node_modules/better-sqlite3/**",
      "node_modules/bindings/**",
      "node_modules/file-uri-to-path/**"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "extraResources": [
      {
        "from": "electron/resources/patch-helper.cjs",
        "to": "patch-helper.cjs"
      }
    ],
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TaskManager",
      "artifactName": "${productName} Setup ${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "asar": true
  }
}
